{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Crimes in Mexico",
  "title": {
    "text": "Overall Crimes vs. High Impact Crimes in Mexico",
    "subtitle": "2015-2024",
    "subtitleColor": "#2E294E",
    "fontSize": 18,
    "font": "sans-serif",
    "anchor": "start",
    "offset": 20
  },
  "background": "#F5F2EB",
  "padding": {"left": 10, "right": 10, "top": 10, "bottom": 10},
  "spacing": 20,
  "vconcat": [
    {
      "width": 800,
      "height": 400,
      "layer": [
        {
          "data": {
            "url": "https://raw.githubusercontent.com/mercedeshf/mercedeshf.github.io/refs/heads/main/crimedata_peryear.csv"
          },
          "transform": [
            {"filter": "datum['year'] >= 2015 && datum['year'] <= 2024"}
          ],
          "mark": {
            "type": "line",
            "point": {"filled": true, "size": 80},
            "strokeWidth": 3
          },
          "encoding": {
            "x": {
              "field": "year",
              "type": "quantitative",
              "title": "Year",
              "axis": {
                "format": "d",
                "labelFontSize": 11,
                "titleFontSize": 12,
                "grid": false
              }
            },
            "y": {
              "field": "total_crimes",
              "type": "quantitative",
              "title": "Total Crimes",
              "axis": {
                "labelFontSize": 11,
                "titleFontSize": 12,
                "grid": true,
                "gridColor": "#2E294E",
                "gridOpacity": 0.1
              }
            },
            "color": {
              "datum": "Total Crimes",
              "title": "Crime Category",
              "scale": {
                "domain": ["Total Crimes", "High Impact Crimes"],
                "range": ["#E4007C", "#2E294E"]
              }
            },
            "tooltip": [
              {"field": "year", "title": "Year"},
              {"field": "total_crimes", "title": "Total Crimes", "format": ","}
            ]
          }
        },
        {
          "data": {
            "url": "https://raw.githubusercontent.com/mercedeshf/mercedeshf.github.io/refs/heads/main/crime_data_per_year_national.csv"
          },
          "transform": [
            {"filter": "datum['year'] >= 2015 && datum['year'] <= 2024"},
            {"filter": "datum['is_high_impact'] == 1"},
            {
              "aggregate": [
                {"op": "sum", "field": "total", "as": "total_high_impact"}
              ],
              "groupby": ["year"]
            }
          ],
          "mark": {
            "type": "line",
            "point": {"filled": true, "size": 80},
            "strokeWidth": 3
          },
          "encoding": {
            "x": {"field": "year", "type": "quantitative"},
            "y": {"field": "total_high_impact", "type": "quantitative"},
            "color": {"datum": "High Impact Crimes"},
            "tooltip": [
              {"field": "year", "title": "Year"},
              {
                "field": "total_high_impact",
                "title": "High Impact Crimes",
                "format": ","
              }
            ]
          }
        }
      ]
    },
    {
      "width": 600,
      "height": 20,
      "layer": [
        {
          "data": {"values": [{}]},
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "top",
            "dx": 55,
            "fontSize": 10,
            "color": "#2E294E",
            "text": "Source:"
          }
        },
        {
          "data": {"values": [{}]},
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "top",
            "dx": 100,
            "fontSize": 10,
            "fontStyle": "italic",
            "color": "#2E294E",
            "text": "Secretariado Ejecutivo del Sistema Nacional de Seguridad Pública de México, own categorization"
          }
        }
      ]
    }
  ],
  "config": {
    "view": {"stroke": null},
    "legend": {
      "orient": "right",
      "titleColor": "#2E294E",
      "labelColor": "#2E294E",
      "fillColor": "#F5F2EB",
      "padding": 10
    }
  }
}