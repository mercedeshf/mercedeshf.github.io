{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Crime data comparison with predictions",
  "title": {
    "text": "'High Impact' Crime Trends in Mexico",
    "subtitle": "Total reported cases (solid) vs Predicted (dashed), 2015-2024",
    "subtitleColor": "#2E294E",
    "fontSize": 18,
    "font": "sans-serif",
    "anchor": "start",
    "offset": 20
  },
  "background": "#F5F2EB",
  "padding": {"left": 10, "right": 10, "top": 10, "bottom": 10},
  "spacing": 20,
  "vconcat": [
    {
      "hconcat": [
        {
          "width": 380,
          "height": 200,
          "title": {"text": "Kidnapping", "fontSize": 14, "color": "#E4007C"},
          "data": {
            "url": "https://raw.githubusercontent.com/mercedeshf/mercedeshf.github.io/refs/heads/main/high_impact_crimes_per_year_national_with_predicted.csv"
          },
          "transform": [
            {"filter": "datum.type_of_crime == 'Kidnapping'"},
            {"filter": "datum.year >= 2015 && datum.year < 2025"}
          ],
          "layer": [
            {
              "mark": {
                "type": "line",
                "point": {"filled": true, "size": 60, "color": "#E4007C"},
                "strokeWidth": 3,
                "color": "#E4007C"
              },
              "encoding": {
                "x": {
                  "field": "year",
                  "type": "quantitative",
                  "title": "Year",
                  "axis": {
                    "format": "d",
                    "labelFontSize": 10,
                    "titleFontSize": 11,
                    "grid": false
                  }
                },
                "y": {
                  "field": "total",
                  "type": "quantitative",
                  "title": "Total Crimes",
                  "axis": {
                    "labelFontSize": 10,
                    "titleFontSize": 11,
                    "grid": true,
                    "gridColor": "#2E294E",
                    "gridOpacity": 0.1
                  }
                },
                "tooltip": [
                  {"field": "year", "type": "quantitative", "title": "Year"},
                  {
                    "field": "total",
                    "type": "quantitative",
                    "title": "Total Crimes",
                    "format": ",.0f"
                  },
                  {
                    "field": "predicted_total",
                    "type": "quantitative",
                    "title": "Predicted",
                    "format": ",.0f"
                  }
                ]
              }
            },
            {
              "mark": {
                "type": "line",
                "strokeDash": [5, 5],
                "strokeWidth": 2,
                "color": "#E4007C",
                "opacity": 0.7
              },
              "encoding": {
                "x": {"field": "year", "type": "quantitative"},
                "y": {"field": "predicted_total", "type": "quantitative"}
              }
            }
          ]
        },
